<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.northwind</groupId>
    <artifactId>billing-service</artifactId>
    <version>4.11.0-SNAPSHOT</version>
    <name>billing-service</name>
    <description>Invoicing and card charging for Northwind Retail</description>

    <properties>
        <java.version>17</java.version>
        <!--
          The redemption event contract we consume from coupon-service. Hand-written DTO, not
          generated: RedemptionCompletedEvent is written against coupon-service
          docs/api/redemption.md at this version, and is strict, so a field they add or rename
          without a coordinated bump here stops our rebate attribution.
        -->
        <coupon.contract.version>2.4.0</coupon.contract.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
